# Required
APIFY_TOKEN=apify_api_xxx            # Apify Console -> Settings -> API & Integrations
SITE_URL=https://docs.example.com/   # the site to keep in sync

# Optional
STATE_KEY=example-docs               # one per site/index; keeps the baseline between runs
MAX_PAGES=200
EMBED_MODEL=BAAI/bge-small-en-v1.5   # fastembed model (384 dimensions)

# Chroma
CHROMA_PATH=./chroma
COLLECTION=docs

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=docs
PINECONE_NAMESPACE=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# pgvector
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
PG_TABLE=doc_chunks
