          "name": "OpenAI API key (header)"
        }
      }
    },
    {
      "id": "b1168431-4089-5c2b-95a6-0e6edcf15c92",
      "name": "Attach vectors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        220
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Pair each embedding batch with the points it was made for.\nconst batch = $('Deletes or upserts?').item.json;\nconst vectors = [...$json.data].sort((a, b) => a.index - b.index).map((d) => d.embedding);\nif (vectors.length !== batch.points.length) throw new Error('Embedding count does not match the batch');\nreturn { json: { points: batch.points.map((p, i) => ({ ...p, vector: vectors[i] })) } };"
      }
    },
    {
      "id": "91f76a36-e1e8-5b5e-a031-616877cdc3e5",
      "name": "Qdrant: upsert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
