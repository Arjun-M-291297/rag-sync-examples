        "url": "={{ $('Config').first().json.openAiApiBase }}/v1/embeddings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.embeddingModel, input: $json.texts }) }}",
        "options": {
