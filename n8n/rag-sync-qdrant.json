    {
      "id": "a215ac9a-a503-5c4c-9180-2f8c5a856b25",
      "name": "Run RAG Sync Monitor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apifyApiBase }}/v2/acts/cipherwise~rag-sync-monitor/run-sync-get-dataset-items?timeout=290",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ startUrls: [{ url: $('Config').first().json.siteUrl }], stateKey: $('Config').first().json.stateKey, maxPages: $('Config').first().json.maxPages }) }}",
        "options": {
          "timeout": 300000
        }
      },
